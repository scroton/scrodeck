// windows/res/app.rc — the exe's icon (the Electron deck's own), version block and manifest.
// The version is written in ONE place, core/deck/version.hpp (plain #defines a resource compiler can read; its C++
// is hidden behind RC_INVOKED): FileVersion = the number, ProductVersion = the label the deck calls itself.
#include "../../core/deck/version.hpp"
// the names: the edition's (its #defines; the C++ behind RC_INVOKED)
#include "../../core/deck/edition.hpp"
1 ICON "../../assets/icon.ico"
// a remote window's icon: the same picture on blue (make-remote-icon.py), so it is told apart on the taskbar
2 ICON "remote.ico"
// the bundled console fonts (gfx.hpp loadFontResources)
#include "fonts.rc"
// the edition's release key (KEYS: its public part): what the updater checks a release's signature with (update.hpp)
2100 RCDATA "../../KEYS"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION CLAUDE_DECK_NATIVE_VERSION_COMMAS
PRODUCTVERSION CLAUDE_DECK_NATIVE_VERSION_COMMAS
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", DECK_EDITION_DESCRIPTION
      VALUE "ProductName", DECK_EDITION_PRODUCT
      VALUE "FileVersion", CLAUDE_DECK_NATIVE_VERSION
      VALUE "ProductVersion", CLAUDE_DECK_NATIVE_VERSION_LABEL
      VALUE "OriginalFilename", DECK_EDITION_EXE
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
